APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
SEED_DEMO_USERS=true
SESSION_COOKIE_SECURE=false

# Optional path overrides
# UPLOAD_FOLDER=/tmp/bluelens/uploads
# EXPORT_FOLDER=/tmp/bluelens/exports
# REPORT_FOLDER=/tmp/bluelens/reports
# LOG_FOLDER=/tmp/bluelens/logs
# MAX_CONTENT_LENGTH=26214400

# Optional external SQLAlchemy database URL.
# Install the matching database driver before enabling it.
# DATABASE_URL=postgresql://user:password@host:5432/bluelens
